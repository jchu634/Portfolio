{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/public",
      "!!**/.next",
      "!!**/out",
      "!!**/build",
      "!next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "domains": { "next": "recommended", "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "complexity": { "noUselessSwitchCase": "off" },
      "nursery": {
        "useTailwindSortedClasses": { "level": "warn", "fix": "safe" }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "tailwind": {
    "stylesheet": "./app/globals.css",
    "mergeFunctions": ["cn", "clsx", "tw", "twMerge"]
  }
}
